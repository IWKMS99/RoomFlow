# Настройки PostgreSQL
POSTGRES_DB=roomflow_db
POSTGRES_USER=myuser
POSTGRES_PASSWORD=fialka

# Порт приложения для разработки
SERVER_PORT=8080

# Секрет для JWT
JWT_SECRET=yoursupersecretkeyforjwtthatisverylongandsecure
JWT_EXPIRATION=3600000

# MinIO/S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=roomflow-files
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PRESIGN_TTL_MINUTES=15

# Public SEO base URL
APP_PUBLIC_BASE_URL=http://localhost:8080

# Holiday API
HOLIDAY_API_BASE_URL=https://date.nager.at
HOLIDAY_API_TIMEOUT_MS=1000
HOLIDAY_DEFAULT_COUNTRY=RU
